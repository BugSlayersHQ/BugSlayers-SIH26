generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          Int      @id @default(autoincrement())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model User {
  id            Int              @id @default(autoincrement())
  clerkUserId   String           @unique
  name          String
  email         String           @unique
  phone         String?
  adminId       Int
  admin         Admin            @relation(fields: [adminId], references: [id])
  uploadedFiles File[]           @relation("UploadedFiles")
  assignments   FileAssignment[] @relation("FileAssignments")
  assignedFiles FileAssignment[] @relation("FileAssigners")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}


model File {
  id           Int              @id @default(autoincrement())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById Int
  uploadedBy   User             @relation("UploadedFiles", fields: [uploadedById], references: [id])
  assignments  FileAssignment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model FileAssignment {
  id         Int      @id @default(autoincrement())
  fileId     Int
  userId     Int
  assignedBy Int
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User     @relation("FileAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assigner   User     @relation("FileAssigners", fields: [assignedBy], references: [id])
  createdAt  DateTime @default(now())

  @@unique([fileId, userId])
}
